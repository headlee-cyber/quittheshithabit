<!DOCTYPE html>
<html lang="ja">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0">
<meta name="theme-color" content="#09090f">
<meta name="apple-mobile-web-app-capable" content="yes">
<meta name="apple-mobile-web-app-status-bar-style" content="black-translucent">
<title>Tomo — あなたの伴走者</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Noto+Sans+JP:wght@300;400;500;700&family=DM+Serif+Display:ital@0;1&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet">
<style>
:root {
  --bg: #09090f;
  --surface: #111118;
  --surface2: #18181f;
  --border: rgba(255,255,255,0.06);
  --border2: rgba(255,255,255,0.11);
  --text: #eeedf5;
  --text2: rgba(238,237,245,0.55);
  --text3: rgba(238,237,245,0.28);
  --accent: #8b7cf8;
  --accent2: #6c5ce7;
  --green: #00d68f;
  --red: #ff6b6b;
  --r: 16px;
  --r-sm: 10px;
}

* { box-sizing: border-box; margin: 0; padding: 0; -webkit-tap-highlight-color: transparent; }

body {
  font-family: 'Noto Sans JP', sans-serif;
  background: var(--bg);
  color: var(--text);
  min-height: 100vh;
  max-width: 430px;
  margin: 0 auto;
  overflow-x: hidden;
  position: relative;
}

/* ── COMPANION SVG ── */
.companion-wrap {
  display: flex;
  align-items: center;
  justify-content: center;
  position: relative;
}

.companion-figure {
  transition: opacity 1.2s ease, filter 1.2s ease;
  overflow: visible;
}

.companion-figure.s0 { opacity: 0.08; filter: grayscale(1) blur(1px); }
.companion-figure.s1 { opacity: 0.22; filter: grayscale(0.7) drop-shadow(0 0 6px rgba(108,92,231,0.2)); }
.companion-figure.s2 { opacity: 0.40; filter: grayscale(0.4) drop-shadow(0 0 10px rgba(108,92,231,0.3)); }
.companion-figure.s3 { opacity: 0.58; filter: grayscale(0.15) drop-shadow(0 0 14px rgba(108,92,231,0.45)); }
.companion-figure.s4 { opacity: 0.76; filter: drop-shadow(0 0 18px rgba(108,92,231,0.55)); }
.companion-figure.s5 { opacity: 0.90; filter: drop-shadow(0 0 22px rgba(108,92,231,0.65)); }
.companion-figure.born {
  opacity: 1;
  filter: drop-shadow(0 0 28px rgba(139,124,248,0.8));
  animation: companionGlow 3s ease-in-out infinite;
}
.companion-figure.focus-alive {
  opacity: 1;
  filter: drop-shadow(0 0 32px rgba(0,214,143,0.7));
  animation: companionGlowGreen 2.5s ease-in-out infinite;
}
.companion-figure.focus-dead {
  opacity: 0.35;
  filter: grayscale(1) blur(0.5px);
  transition: all 0.8s ease;
}

@keyframes companionGlow {
  0%,100% { filter: drop-shadow(0 0 22px rgba(139,124,248,0.7)); }
  50%      { filter: drop-shadow(0 0 36px rgba(139,124,248,1)); }
}
@keyframes companionGlowGreen {
  0%,100% { filter: drop-shadow(0 0 24px rgba(0,214,143,0.6)); }
  50%      { filter: drop-shadow(0 0 42px rgba(0,214,143,0.95)); }
}
@keyframes torsoBreath {
  0%,100% { transform: scaleY(1); }
  50%      { transform: scaleY(1.018); }
}
.comp-torso { transform-origin: 50px 140px; animation: torsoBreath 4s ease-in-out infinite; }

/* ── ONBOARDING ── */
#onboard {
  min-height: 100vh;
  display: flex;
  flex-direction: column;
}

.ob-screen {
  display: none;
  flex-direction: column;
  min-height: 100vh;
  padding: 0 24px 40px;
  animation: fadeUp 0.35s ease;
}
.ob-screen.active { display: flex; }

@keyframes fadeUp {
  from { opacity: 0; transform: translateY(12px); }
  to   { opacity: 1; transform: translateY(0); }
}

.ob-progress {
  display: flex;
  gap: 5px;
  padding: 56px 0 0;
  margin-bottom: 28px;
}
.ob-prog-dot {
  height: 3px;
  flex: 1;
  border-radius: 2px;
  background: var(--border2);
  transition: background 0.4s ease;
}
.ob-prog-dot.done { background: var(--accent); }
.ob-prog-dot.active { background: rgba(139,124,248,0.5); }

.ob-companion-area {
  display: flex;
  justify-content: center;
  margin-bottom: 28px;
}

.ob-bubble {
  background: var(--surface);
  border: 0.5px solid var(--border2);
  border-radius: 18px 18px 18px 4px;
  padding: 16px 20px;
  font-size: 15px;
  line-height: 1.75;
  color: var(--text);
  margin-bottom: 28px;
  position: relative;
}

.ob-bubble-name {
  font-size: 10px;
  color: var(--accent);
  letter-spacing: 0.1em;
  margin-bottom: 6px;
}

.ob-options {
  display: flex;
  flex-direction: column;
  gap: 10px;
  margin-bottom: 24px;
}

.ob-opt {
  background: var(--surface);
  border: 1.5px solid var(--border2);
  border-radius: var(--r);
  padding: 16px 20px;
  font-size: 14px;
  color: var(--text2);
  cursor: pointer;
  text-align: left;
  font-family: 'Noto Sans JP', sans-serif;
  transition: all 0.15s;
  display: flex;
  align-items: center;
  gap: 12px;
}
.ob-opt:active { transform: scale(0.98); }
.ob-opt.selected {
  border-color: var(--accent);
  background: rgba(139,124,248,0.1);
  color: var(--text);
}
.ob-opt-icon { font-size: 20px; flex-shrink: 0; }

.ob-input-wrap {
  background: var(--surface);
  border: 1.5px solid var(--border2);
  border-radius: var(--r);
  padding: 4px 4px 4px 18px;
  display: flex;
  align-items: center;
  margin-bottom: 24px;
  transition: border-color 0.2s;
}
.ob-input-wrap:focus-within { border-color: var(--accent); }
.ob-input-wrap input {
  background: none;
  border: none;
  outline: none;
  color: var(--text);
  font-size: 16px;
  font-family: 'Noto Sans JP', sans-serif;
  flex: 1;
  padding: 14px 0;
}
.ob-input-wrap input::placeholder { color: var(--text3); }

.btn-primary {
  background: linear-gradient(135deg, var(--accent2), var(--accent));
  color: #fff;
  border: none;
  border-radius: var(--r);
  padding: 16px;
  font-size: 15px;
  font-weight: 500;
  cursor: pointer;
  font-family: 'Noto Sans JP', sans-serif;
  width: 100%;
  transition: opacity 0.15s;
  letter-spacing: 0.02em;
}
.btn-primary:active { opacity: 0.85; }
.btn-primary:disabled { opacity: 0.35; cursor: default; }

.btn-ghost {
  background: transparent;
  color: var(--text3);
  border: none;
  padding: 12px;
  font-size: 13px;
  cursor: pointer;
  font-family: 'Noto Sans JP', sans-serif;
  width: 100%;
  margin-top: 4px;
}

/* welcome screen */
.welcome-hero {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  text-align: center;
  padding: 60px 0 40px;
}

.welcome-title {
  font-family: 'DM Serif Display', serif;
  font-size: 42px;
  color: var(--text);
  margin-bottom: 6px;
  letter-spacing: -0.5px;
}

.welcome-sub {
  font-size: 13px;
  color: var(--text3);
  letter-spacing: 0.1em;
  margin-bottom: 48px;
}

.welcome-desc {
  font-size: 14px;
  color: var(--text2);
  line-height: 1.85;
  max-width: 300px;
  margin-bottom: 48px;
}

/* generating screen */
.gen-screen {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  text-align: center;
  padding: 40px 0;
}
.gen-label {
  font-size: 13px;
  color: var(--text3);
  letter-spacing: 0.1em;
  margin-top: 28px;
}
.gen-dots {
  display: flex;
  gap: 6px;
  justify-content: center;
  margin-top: 12px;
}
.gen-dot {
  width: 6px; height: 6px;
  border-radius: 50%;
  background: var(--accent);
  animation: genDot 1.4s ease-in-out infinite;
}
.gen-dot:nth-child(2) { animation-delay: 0.2s; }
.gen-dot:nth-child(3) { animation-delay: 0.4s; }
@keyframes genDot {
  0%,80%,100% { opacity: 0.2; transform: scale(0.8); }
  40%          { opacity: 1;   transform: scale(1.2); }
}

/* meeting screen */
.meet-screen {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 60px 0 0;
}
.meet-name {
  font-family: 'DM Serif Display', serif;
  font-size: 32px;
  color: var(--text);
  margin-top: 20px;
  margin-bottom: 4px;
}
.meet-tag {
  font-size: 11px;
  color: var(--accent);
  letter-spacing: 0.12em;
  margin-bottom: 28px;
}
.meet-profile {
  background: var(--surface);
  border: 0.5px solid var(--border2);
  border-radius: var(--r);
  padding: 18px 20px;
  margin-bottom: 20px;
  width: 100%;
}
.meet-profile-row {
  display: flex;
  gap: 8px;
  align-items: flex-start;
  padding: 8px 0;
  border-bottom: 0.5px solid var(--border);
  font-size: 13px;
  color: var(--text2);
  line-height: 1.6;
}
.meet-profile-row:last-child { border-bottom: none; }
.meet-profile-icon { flex-shrink: 0; font-size: 15px; margin-top: 1px; }

/* ── APP SCREENS ── */
#app { display: none; }

.page { display: none; padding: 0 20px 100px; animation: fadeUp 0.25s ease; }
.page.active { display: block; }

/* NAV */
.nav {
  position: fixed;
  bottom: 0; left: 50%;
  transform: translateX(-50%);
  width: 100%; max-width: 430px;
  background: rgba(9,9,15,0.93);
  backdrop-filter: blur(20px);
  border-top: 0.5px solid var(--border2);
  display: flex;
  z-index: 100;
  padding: 0 8px;
  padding-bottom: env(safe-area-inset-bottom);
}
.nav-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 10px 4px 8px;
  cursor: pointer;
  gap: 4px;
  background: none;
  border: none;
  color: var(--text3);
  font-family: 'Noto Sans JP', sans-serif;
  font-size: 10px;
  transition: color 0.2s;
}
.nav-item.active { color: var(--accent); }
.nav-icon { width: 24px; height: 24px; display: flex; align-items: center; justify-content: center; }

/* HOME */
.home-header {
  padding: 56px 0 20px;
  display: flex;
  align-items: center;
  justify-content: space-between;
}
.home-greeting { font-size: 13px; color: var(--text3); margin-bottom: 3px; }
.home-name { font-family: 'DM Serif Display', serif; font-size: 26px; }

.home-companion-section {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 8px 0 28px;
  position: relative;
}

.companion-status {
  font-size: 11px;
  color: var(--text3);
  letter-spacing: 0.1em;
  text-transform: uppercase;
  margin-top: 14px;
  margin-bottom: 4px;
}
.companion-name-home {
  font-family: 'DM Serif Display', serif;
  font-size: 22px;
  color: var(--text);
  margin-bottom: 16px;
}

.home-stats {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 8px;
  margin-bottom: 16px;
  width: 100%;
}
.stat-box {
  background: var(--surface);
  border: 0.5px solid var(--border);
  border-radius: var(--r-sm);
  padding: 14px 8px;
  text-align: center;
}
.stat-box-val {
  font-family: 'JetBrains Mono', monospace;
  font-size: 18px;
  font-weight: 500;
  margin-bottom: 4px;
}
.stat-box-key { font-size: 10px; color: var(--text3); }

.card {
  background: var(--surface);
  border: 0.5px solid var(--border);
  border-radius: var(--r);
  padding: 18px;
  margin-bottom: 12px;
}
.card-label {
  font-size: 10px;
  color: var(--text3);
  letter-spacing: 0.1em;
  text-transform: uppercase;
  margin-bottom: 10px;
}

/* FOCUS */
.focus-setup-header {
  padding: 56px 0 20px;
  text-align: center;
}

.duration-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 8px;
  margin-bottom: 16px;
}
.dur-btn {
  background: var(--surface2);
  border: 1.5px solid var(--border);
  border-radius: var(--r-sm);
  padding: 14px 4px 10px;
  text-align: center;
  cursor: pointer;
  font-family: 'JetBrains Mono', monospace;
  font-size: 18px;
  font-weight: 500;
  color: var(--text);
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 3px;
  transition: all 0.15s;
}
.dur-btn span { font-size: 10px; color: inherit; opacity: 0.6; font-family: 'Noto Sans JP', sans-serif; font-weight: 400; }
.dur-btn:active { transform: scale(0.96); }
.dur-btn.selected { border-color: var(--accent); background: rgba(139,124,248,0.1); color: var(--accent); }

.focus-state { display: none; }
.focus-state.active { display: block; }

.session-wrap {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 24px 0 16px;
}

.session-ring-wrap {
  position: relative;
  width: 220px;
  height: 220px;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 24px;
}

.session-ring-svg {
  position: absolute;
  top: 0; left: 0;
  pointer-events: none;
}

.session-timer {
  font-family: 'JetBrains Mono', monospace;
  font-size: 48px;
  font-weight: 500;
  letter-spacing: -2px;
  margin-bottom: 4px;
  transition: color 0.3s;
}
.session-timer.dead { color: var(--red); }
.session-timer.complete { color: var(--green); }

.session-label {
  font-size: 11px;
  color: var(--text3);
  letter-spacing: 0.1em;
  text-transform: uppercase;
  margin-bottom: 24px;
}

.leave-banner {
  background: rgba(255,107,107,0.1);
  border: 0.5px solid rgba(255,107,107,0.3);
  border-radius: var(--r-sm);
  padding: 10px 14px;
  font-size: 13px;
  color: var(--red);
  text-align: center;
  margin-bottom: 12px;
  display: none;
}
.leave-banner.show { display: block; animation: fadeUp 0.2s ease; }

.btn-danger {
  background: rgba(255,107,107,0.08);
  border: 0.5px solid rgba(255,107,107,0.22);
  color: var(--red);
  border-radius: var(--r-sm);
  padding: 12px;
  font-size: 13px;
  cursor: pointer;
  font-family: 'Noto Sans JP', sans-serif;
  width: 100%;
  transition: background 0.15s;
}
.btn-danger:active { background: rgba(255,107,107,0.18); }

.btn-green {
  background: rgba(0,214,143,0.1);
  border: 0.5px solid rgba(0,214,143,0.28);
  color: var(--green);
  border-radius: var(--r-sm);
  padding: 14px;
  font-size: 14px;
  font-weight: 500;
  cursor: pointer;
  font-family: 'Noto Sans JP', sans-serif;
  width: 100%;
  margin-bottom: 8px;
  transition: background 0.15s;
}
.btn-green:active { background: rgba(0,214,143,0.2); }

/* CHAT */
.chat-header {
  padding: 56px 0 16px;
  display: flex;
  align-items: center;
  gap: 14px;
}
.chat-companion-avatar {
  width: 44px;
  height: 44px;
  border-radius: 50%;
  background: linear-gradient(135deg, var(--accent2), var(--accent));
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 20px;
  flex-shrink: 0;
  box-shadow: 0 0 16px rgba(139,124,248,0.4);
}
.chat-companion-info { flex: 1; }
.chat-companion-name-small { font-size: 15px; font-weight: 500; margin-bottom: 2px; }
.chat-companion-status { font-size: 11px; color: var(--accent); }

.chat-messages {
  display: flex;
  flex-direction: column;
  gap: 14px;
  margin-bottom: 20px;
  min-height: 200px;
}

.chat-msg {
  display: flex;
  gap: 10px;
  animation: fadeUp 0.3s ease;
}

.chat-msg.user { flex-direction: row-reverse; }

.chat-msg-bubble {
  max-width: 75%;
  padding: 12px 16px;
  border-radius: 18px;
  font-size: 14px;
  line-height: 1.65;
}

.chat-msg.companion .chat-msg-bubble {
  background: var(--surface);
  border: 0.5px solid var(--border2);
  border-bottom-left-radius: 4px;
  color: var(--text);
}

.chat-msg.user .chat-msg-bubble {
  background: rgba(139,124,248,0.18);
  border: 0.5px solid rgba(139,124,248,0.3);
  border-bottom-right-radius: 4px;
  color: var(--text);
}

.chat-msg-avatar {
  width: 32px; height: 32px;
  border-radius: 50%;
  background: linear-gradient(135deg, var(--accent2), var(--accent));
  flex-shrink: 0;
  align-self: flex-end;
  box-shadow: 0 0 10px rgba(139,124,248,0.3);
}

.chat-reply-options {
  display: flex;
  flex-direction: column;
  gap: 8px;
  margin-bottom: 16px;
}
.chat-reply-opt {
  background: var(--surface);
  border: 1px solid var(--border2);
  border-radius: 20px;
  padding: 11px 18px;
  font-size: 13px;
  color: var(--text2);
  cursor: pointer;
  text-align: left;
  font-family: 'Noto Sans JP', sans-serif;
  transition: all 0.15s;
}
.chat-reply-opt:active { background: rgba(139,124,248,0.12); border-color: var(--accent); color: var(--text); }

.chat-free-input {
  display: flex;
  gap: 8px;
  align-items: center;
  background: var(--surface);
  border: 0.5px solid var(--border2);
  border-radius: 24px;
  padding: 4px 4px 4px 18px;
  margin-bottom: 12px;
}
.chat-free-input input {
  background: none;
  border: none;
  outline: none;
  color: var(--text);
  font-size: 14px;
  font-family: 'Noto Sans JP', sans-serif;
  flex: 1;
  padding: 10px 0;
}
.chat-free-input input::placeholder { color: var(--text3); }
.chat-send-btn {
  width: 36px; height: 36px;
  border-radius: 50%;
  background: var(--accent);
  border: none;
  cursor: pointer;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  transition: opacity 0.15s;
}
.chat-send-btn:active { opacity: 0.75; }

/* MODAL ABANDON */
.modal-overlay {
  position: fixed;
  inset: 0;
  background: rgba(0,0,0,0.7);
  backdrop-filter: blur(4px);
  z-index: 200;
  display: none;
  align-items: flex-end;
  justify-content: center;
}
.modal-overlay.open { display: flex; }
.modal {
  background: var(--surface);
  border-top: 0.5px solid var(--border2);
  border-radius: 20px 20px 0 0;
  padding: 24px 20px 40px;
  width: 100%;
  max-width: 430px;
  animation: slideUp 0.25s ease;
}
@keyframes slideUp { from { transform: translateY(100%); } to { transform: translateY(0); } }
.modal-handle { width: 36px; height: 4px; background: var(--border2); border-radius: 2px; margin: 0 auto 20px; }
.modal-title { font-family: 'DM Serif Display', serif; font-size: 22px; margin-bottom: 8px; }
.modal-sub { font-size: 13px; color: var(--text2); margin-bottom: 20px; line-height: 1.65; }

/* TOAST */
.toast {
  position: fixed;
  top: 56px; left: 50%;
  transform: translateX(-50%) translateY(-16px);
  background: var(--surface);
  border: 0.5px solid var(--border2);
  border-radius: 30px;
  padding: 10px 20px;
  font-size: 13px;
  z-index: 300;
  opacity: 0;
  transition: all 0.3s;
  pointer-events: none;
  white-space: nowrap;
}
.toast.show { opacity: 1; transform: translateX(-50%) translateY(0); }

/* spark animation on companion birth */
@keyframes sparkBurst {
  0%   { opacity: 1; transform: scale(0) translate(0,0); }
  100% { opacity: 0; transform: scale(1) translate(var(--tx), var(--ty)); }
}
.spark {
  position: absolute;
  width: 6px; height: 6px;
  border-radius: 50%;
  background: var(--accent);
  animation: sparkBurst 0.8s ease-out forwards;
}
</style>
</head>
<body>

<div class="toast" id="toast"></div>

<!-- ══════════════════════════════
     ONBOARDING
══════════════════════════════ -->
<div id="onboard">

  <!-- WELCOME -->
  <div class="ob-screen active" id="ob-welcome" style="padding:0 24px 40px;">
    <div class="welcome-hero">
      <div class="companion-wrap" style="margin-bottom:36px;">
        <svg class="companion-figure s0" id="comp-svg-ob" width="120" height="220" viewBox="0 0 100 200" fill="none">
          <defs>
            <linearGradient id="cg" x1="0%" y1="0%" x2="100%" y2="100%">
              <stop offset="0%" stop-color="#9b8fff"/>
              <stop offset="100%" stop-color="#6c5ce7"/>
            </linearGradient>
          </defs>
          <circle cx="50" cy="28" r="22" fill="url(#cg)"/>
          <rect x="43" y="48" width="14" height="14" rx="7" fill="url(#cg)"/>
