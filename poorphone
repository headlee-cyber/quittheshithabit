        </svg>
        <div class="session-timer complete" style="font-size:32px;margin-bottom:6px;">達成！</div>
        <div class="session-label" id="complete-label">25分間、一緒にいられました</div>
        <div style="width:100%;margin-top:8px;">
          <div class="card" style="text-align:center;padding:18px;margin-bottom:12px;background:rgba(0,214,143,0.04);border-color:rgba(0,214,143,0.15);">
            <div style="font-size:24px;margin-bottom:8px;">🎉</div>
            <div style="font-size:14px;font-weight:500;color:var(--green);margin-bottom:6px;">二人で時間を積み重ねました</div>
            <div style="font-size:13px;color:var(--text2);line-height:1.65;" id="complete-msg">また話しましょう。</div>
          </div>
          <button class="btn-green" onclick="goToChat()">話しかける</button>
          <button class="btn-ghost" onclick="showFocusState('setup')">もう一度集中する</button>
        </div>
      </div>
    </div>

  </div><!-- /page-focus -->

  <!-- CHAT -->
  <div class="page" id="page-chat">
    <div class="chat-header">
      <div class="chat-companion-avatar" id="chat-avatar">🌿</div>
      <div class="chat-companion-info">
        <div class="chat-companion-name-small" id="chat-comp-name">—</div>
        <div class="chat-companion-status">あなたの伴走者 · 今ここにいます</div>
      </div>
    </div>
    <div class="chat-messages" id="chat-messages"></div>
    <div class="chat-reply-options" id="chat-reply-options"></div>
    <div class="chat-free-input" id="chat-free-input" style="display:none;">
      <input type="text" id="chat-input" placeholder="メッセージを入力..." maxlength="200">
      <button class="chat-send-btn" onclick="sendFreeMessage()">
        <svg width="16" height="16" viewBox="0 0 16 16" fill="none">
          <path d="M2 8L14 8M14 8L9 3M14 8L9 13" stroke="white" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
      </button>
    </div>
  </div>

  <!-- BOTTOM NAV -->
  <nav class="nav">
    <button class="nav-item active" data-page="home" onclick="switchPage('home',this)">
      <div class="nav-icon">
        <svg width="22" height="22" viewBox="0 0 22 22" fill="none" stroke="currentColor" stroke-width="1.5">
          <path d="M3 9.5L11 3L19 9.5V19a1 1 0 01-1 1H4a1 1 0 01-1-1V9.5z"/>
        </svg>
      </div>ホーム
    </button>
    <button class="nav-item" data-page="focus" onclick="switchPage('focus',this)">
      <div class="nav-icon">
        <svg width="22" height="22" viewBox="0 0 22 22" fill="none" stroke="currentColor" stroke-width="1.5">
          <circle cx="11" cy="11" r="8"/>
          <path d="M11 7v4l3 3"/>
        </svg>
      </div>フォーカス
    </button>
    <button class="nav-item" data-page="chat" onclick="switchPage('chat',this)">
      <div class="nav-icon">
        <svg width="22" height="22" viewBox="0 0 22 22" fill="none" stroke="currentColor" stroke-width="1.5">
          <path d="M4 4h14a1 1 0 011 1v9a1 1 0 01-1 1H8l-4 3V5a1 1 0 011-1z"/>
        </svg>
      </div>話す
    </button>
  </nav>

</div><!-- /app -->

<!-- MODAL: ABANDON -->
<div class="modal-overlay" id="modal-abandon">
  <div class="modal">
    <div class="modal-handle"></div>
    <div class="modal-title">セッションを中断しますか？</div>
    <div class="modal-sub" id="abandon-msg">離れてしまうと、伴走者も一人になります。本当に中断しますか？</div>
    <button class="btn-primary" style="background:rgba(255,107,107,0.85);margin-bottom:8px;" onclick="doAbandon()">中断する</button>
    <button class="btn-ghost" onclick="closeModal('modal-abandon')">続ける</button>
  </div>
</div>

<script>
// ── STATE ──
let userData = {};
let companion = {};
let focusDuration = 25;
let focusInterval = null;
let focusSecsLeft = 0;
let focusTotalSecs = 0;
let leaveTs = null;
const KILL_THRESH = 12000;

const STEPS = ['name','age','gender','life','escape','aspire'];
const STEP_TOTAL = STEPS.length;

// ── COMPANION NAMES ──
const NAMES = {
  male:   { teen:['そうた','はると','ゆうと'], twenties:['けんと','ゆうき','こうへい'], thirties:['だいき','みつる','たくや'], forties:['けんじ','ひろし','まさき'] },
  female: { teen:['はな','ひな','こころ'],    twenties:['みお','ゆい','あかね'],       thirties:['まい','なな','さゆ'],      forties:['みき','あきこ','けいこ'] },
  other:  { teen:['なつき','はるき'],          twenties:['さとり','かいと'],            thirties:['いつき','まなと'],         forties:['かずき','のぞむ'] },
};

const ESCAPE_DESC = {
  work:     '仕事のプレッシャーで頭がいっぱいになることがある',
  relation: '人間関係の疲れで、誰かと距離を置きたくなることがある',
  future:   '将来のことを考えると、不安で動けなくなることがある',
  lonely:   '孤独な気持ちを抱えながら、それを誰にも言えないことがある',
};
const ASPIRE_DESC = {
  focus:   '少しずつ、集中できる時間を増やしていきたい',
  connect: '大切な人たちとの時間を、もっと深くしたい',
  pursue:  '本当にやりたいことに、向き合えるようになりたい',
  calm:    '日常の中に、心の余裕を作っていきたい',
};
const FIRST_MSG = {
  work:     'はじめまして。仕事のことで頭がいっぱいになること、私にもよくあります。今日、どんな気持ちでここに来ましたか？',
  relation: 'はじめまして。人間関係の疲れ、私も知っています。誰かのことを考えすぎて、自分が消えそうになる感覚。今日は少し、話しましょう。',
  future:   'はじめまして。将来のことって、考えれば考えるほど霧の中に入っていく感じがしませんか。私も同じです。今ここで、一緒にいます。',
  lonely:   'はじめまして。孤独って、不思議ですよね。人の中にいても感じることがある。今日、あなたがここに来てくれて嬉しいです。',
};

const FOCUS_TIPS = [
  'スマホから離れている今、あなたの中の何かが静かに育っています。',
  '一つのことに向き合う時間が、やがて大きな変化を生みます。',
  '集中が続くほど、隣にいる存在との時間も深まっていきます。',
  'この沈黙の中に、あなたの本当の声があります。',
];

const CHAT_FLOW = {
  work: [
    { type:'companion', text:'今日のセッション、お疲れさまでした。仕事のこと、最近どんな感じですか？', replies:['少し落ち着いてきた','まだしんどい','考えたくない'] },
    { type:'companion', text:'その感覚、もう少し聞かせてもらえますか？しんどいとき、スマホを触る前に何を感じていますか？', free:true },
  ],
  relation: [
    { type:'companion', text:'セッション終わりましたね。最近、誰かのことで頭がいっぱいになることはありますか？', replies:['ある','あまりない','一人でいたい'] },
    { type:'companion', text:'そういう時、スマホを見ることで何かが和らぎますか？それとも、余計に気になってしまいますか？', free:true },
  ],
  future: [
    { type:'companion', text:'お疲れさまでした。集中できましたか？将来のこと、今どのくらい頭にありますか？', replies:['かなり気になってる','少しある','今は考えていない'] },
    { type:'companion', text:'将来のことを考えるとき、一番最初に浮かぶ感情は何ですか？', free:true },
  ],
  lonely: [
    { type:'companion', text:'セッション終わりましたね。今日一日、誰かと話しましたか？', replies:['話した','あまり話せなかった','一人だった'] },
    { type:'companion', text:'一人でいる時間が長いとき、何をしていると少し楽になりますか？', free:true },
  ],
};

// ── ONBOARDING ──
function obNext(from, to) {
  document.getElementById('ob-' + from).classList.remove('active');
  const next = document.getElementById('ob-' + to);
  next.classList.add('active');
  renderProgress(to);
}

function renderProgress(screenId) {
  const idx = STEPS.indexOf(screenId);
  if (idx < 0) return;
  const progId = 'prog-' + screenId;
  const el = document.getElementById(progId);
  if (!el) return;
  el.innerHTML = '';
  STEPS.forEach((_, i) => {
    const d = document.createElement('div');
    d.className = 'ob-prog-dot' + (i < idx ? ' done' : i === idx ? ' active' : '');
    el.appendChild(d);
  });
}

function checkNameInput() {
  const v = document.getElementById('input-name').value.trim();
  document.getElementById('btn-name').disabled = v.length === 0;
}

function obSaveName() {
  const v = document.getElementById('input-name').value.trim();
  if (!v) return;
  userData.name = v;
  document.getElementById('bubble-name-age').textContent = v;
  obNext('name', 'age');
}

function obSelect(el, field, val) {
  userData[field] = val;
  const next = { age:'gender', gender:'life', life:'escape', escape:'aspire', aspire:'generating' };
  const current = field === 'age' ? 'age' : field === 'gender' ? 'gender' : field === 'life' ? 'life' : field === 'escape' ? 'escape' : 'aspire';
  // brief visual feedback
  const parent = el.closest('.ob-options');
  parent.querySelectorAll('.ob-opt').forEach(b => b.classList.remove('selected'));
  el.classList.add('selected');
  setTimeout(() => {
    if (next[field] === 'generating') {
      startGenerating();
    } else {
      obNext(current, next[field]);
    }
  }, 250);
}

function startGenerating() {
  obNext('aspire', 'generating');
  generateCompanion();
  setTimeout(() => {
    populateMeetScreen();
    obNext('generating', 'meeting');
  }, 2800);
}

function generateCompanion() {
  const gender = userData.gender || 'other';
  const age = userData.age || 'twenties';
  const pool = NAMES[gender]?.[age] || NAMES.other.twenties;
  const name = pool[Math.floor(Math.random() * pool.length)];
  companion = {
    name,
    escape: userData.escape || 'lonely',
    aspire: userData.aspire || 'calm',
    escapeDesc: ESCAPE_DESC[userData.escape] || ESCAPE_DESC.lonely,
    aspireDesc: ASPIRE_DESC[userData.aspire] || ASPIRE_DESC.calm,
    firstMsg: FIRST_MSG[userData.escape] || FIRST_MSG.lonely,
    totalMinutes: 0,
    sessions: 0,
    streak: 0,
    chatHistory: [],
    chatFlowIdx: 0,
  };
  save();
}

function populateMeetScreen() {
  document.getElementById('meet-name').textContent = companion.name;
  document.getElementById('meet-profile').innerHTML = `
    <div class="meet-profile-row"><span class="meet-profile-icon">💭</span>${companion.escapeDesc}</div>
    <div class="meet-profile-row"><span class="meet-profile-icon">🌱</span>${companion.aspireDesc}</div>
  `;
  document.getElementById('meet-first-msg').innerHTML = `
    <div class="ob-bubble-name">${companion.name.toUpperCase()}</div>
    ${companion.firstMsg}
  `;
}

function enterApp() {
  save();
  document.getElementById('onboard').style.display = 'none';
  document.getElementById('app').style.display = 'block';
  initApp();
}

// ── APP ──
function initApp() {
  const d = new Date();
  const days = ['SUN','MON','TUE','WED','THU','FRI','SAT'];
  document.getElementById('home-date').textContent =
    `${d.getFullYear()}.${String(d.getMonth()+1).padStart(2,'0')}.${String(d.getDate()).padStart(2,'0')} ${days[d.getDay()]}`;

  const h = d.getHours();
  document.getElementById('home-greeting').textContent = h < 12 ? 'おはよう' : h < 18 ? 'こんにちは' : 'こんばんは';
  document.getElementById('home-username').textContent = userData.name + 'さん';
  document.getElementById('home-comp-name').textContent = companion.name;
  document.getElementById('focus-comp-name-sub').textContent = companion.name;
  document.getElementById('focus-comp-name-run').textContent = companion.name;
  document.getElementById('chat-comp-name').textContent = companion.name;
  document.getElementById('comp-msg-label').textContent = companion.name + ' より';
  document.getElementById('home-comp-msg').textContent = companion.firstMsg;
  updateStats();
  initChat();
}

function switchPage(name, btn) {
  if (focusInterval && name !== 'focus') {
    showToast('🌟 フォーカス中です');
    return;
  }
  document.querySelectorAll('.page').forEach(p => p.classList.remove('active'));
  document.querySelectorAll('.nav-item').forEach(b => b.classList.remove('active'));
  document.getElementById('page-' + name).classList.add('active');
  if (btn) btn.classList.add('active');
}

function updateStats() {
  document.getElementById('stat-sessions').textContent = companion.sessions || 0;
  const m = companion.totalMinutes || 0;
  document.getElementById('stat-minutes').textContent = m >= 60 ? (m/60).toFixed(1)+'h' : m+'m';
  document.getElementById('stat-streak').textContent = companion.streak || 0;
}

// ── FOCUS ──
function selectDur(el, mins) {
  document.querySelectorAll('.dur-btn').forEach(d => d.classList.remove('selected'));
  el.classList.add('selected');
  focusDuration = mins;
}

function showFocusState(state) {
  document.querySelectorAll('.focus-state').forEach(s => s.classList.remove('active'));
  document.getElementById('fs-' + state).classList.add('active');
}

function beginFocus() {
  focusSecsLeft = focusDuration * 60;
  focusTotalSecs = focusSecsLeft;
  leaveTs = null;

  document.getElementById('focus-timer').className = 'session-timer';
  document.getElementById('focus-ring').style.strokeDashoffset = '616';
  document.getElementById('leave-banner').classList.remove('show');
  document.getElementById('focus-tip').textContent = FOCUS_TIPS[Math.floor(Math.random() * FOCUS_TIPS.length)];
  document.getElementById('comp-svg-focus').className = 'companion-figure focus-alive';

  showFocusState('running');
  updateFocusDisplay();
  focusInterval = setInterval(focusTick, 1000);

  document.addEventListener('visibilitychange', onVisChange);
}

function focusTick() {
  focusSecsLeft = Math.max(0, focusSecsLeft - 1);
  if (focusSecsLeft === 0) completeFocus();
  else updateFocusDisplay();
}

function updateFocusDisplay() {
  const m = Math.floor(focusSecsLeft / 60);
  const s = focusSecsLeft % 60;
  document.getElementById('focus-timer').textContent = String(m).padStart(2,'0') + ':' + String(s).padStart(2,'0');
  const progress = 1 - focusSecsLeft / focusTotalSecs;
  document.getElementById('focus-ring').style.strokeDashoffset = String(616 * (1 - progress));
}

function onVisChange() {
  if (!focusInterval) return;
  if (document.hidden) {
    leaveTs = Date.now();
  } else {
    if (leaveTs !== null) {
      const away = Date.now() - leaveTs;
      leaveTs = null;
      if (away > KILL_THRESH) {
        killFocus();
      } else {
        const b = document.getElementById('leave-banner');
        b.textContent = `⚠️ ${Math.round(away/1000)}秒離れていました。${companion.name}が待っていましたよ`;
        b.classList.add('show');
        setTimeout(() => b.classList.remove('show'), 3500);
      }
    }
  }
}

function killFocus() {
  clearInterval(focusInterval);
  focusInterval = null;
  document.removeEventListener('visibilitychange', onVisChange);

  const elapsed = focusTotalSecs - focusSecsLeft;
  const pct = Math.round(elapsed / focusTotalSecs * 100);
  document.getElementById('dead-label').textContent = `${companion.name}も待っています`;
  document.getElementById('dead-msg').textContent =
    pct >= 80 ? 'あと少しでした。次は絶対に一緒にいられます。' :
    pct >= 40 ? `${Math.floor(elapsed/60)}分間、一緒にいられました。少しずつ伸ばしていきましょう。` :
    '小さな一歩でも、積み重ねることが大事です。';
  showFocusState('dead');
}

function completeFocus() {
  clearInterval(focusInterval);
  focusInterval = null;
  document.removeEventListener('visibilitychange', onVisChange);

  companion.sessions = (companion.sessions || 0) + 1;
  companion.totalMinutes = (companion.totalMinutes || 0) + focusDuration;
  companion.streak = (companion.streak || 0) + 1;
  save();
  updateStats();

  document.getElementById('complete-label').textContent = `${focusDuration}分間、一緒にいられました`;
  document.getElementById('complete-msg').textContent = `${companion.name}と過ごした時間が、少しずつ積み重なっています。`;
  showFocusState('complete');
  showToast('🌟 セッション完了！');
}

function confirmAbandon() {
  document.getElementById('modal-abandon').classList.add('open');
}
function doAbandon() {
  closeModal('modal-abandon');
  killFocus();
}
function closeModal(id) { document.getElementById(id).classList.remove('open'); }
document.querySelectorAll('.modal-overlay').forEach(m => {
  m.addEventListener('click', e => { if (e.target === m) m.classList.remove('open'); });
});

function goToChat() {
  showFocusState('setup');
  switchPage('chat', document.querySelector('[data-page=chat]'));
  addPostSessionChat();
}

// ── CHAT ──
function initChat() {
  const msgs = document.getElementById('chat-messages');
  msgs.innerHTML = '';
  addChatMsg('companion', companion.firstMsg);
  setTimeout(() => showChatReplies(0), 600);
}

function addChatMsg(role, text) {
  const msgs = document.getElementById('chat-messages');
  const div = document.createElement('div');
  div.className = 'chat-msg ' + role;
  if (role === 'companion') {
    div.innerHTML = `<div class="chat-msg-avatar"></div><div class="chat-msg-bubble">${text}</div>`;
  } else {
    div.innerHTML = `<div class="chat-msg-bubble">${text}</div>`;
  }
  msgs.appendChild(div);
  msgs.scrollTop = msgs.scrollHeight;
}

function showChatReplies(flowIdx) {
  const flow = CHAT_FLOW[companion.escape] || CHAT_FLOW.lonely;
  if (flowIdx >= flow.length) {
    showFreeInput();
    return;
  }
  const step = flow[flowIdx];
  const opts = document.getElementById('chat-reply-options');
  opts.innerHTML = '';
  document.getElementById('chat-free-input').style.display = 'none';

  if (step.replies) {
    step.replies.forEach(r => {
      const btn = document.createElement('button');
      btn.className = 'chat-reply-opt';
      btn.textContent = r;
      btn.onclick = () => {
        addChatMsg('user', r);
        opts.innerHTML = '';
        companion.chatFlowIdx = flowIdx + 1;
        save();
        setTimeout(() => {
          const nextStep = flow[flowIdx + 1];
          if (nextStep) {
            addChatMsg('companion', nextStep.text);
            setTimeout(() => showChatReplies(flowIdx + 1), 400);
          } else {
            showFreeInput();
          }
        }, 700);
      };
      opts.appendChild(btn);
    });
  } else if (step.free) {
    showFreeInput();
  }
}

function showFreeInput() {
  document.getElementById('chat-reply-options').innerHTML = '';
  document.getElementById('chat-free-input').style.display = 'flex';
  document.getElementById('chat-input').focus();
}

function sendFreeMessage() {
  const input = document.getElementById('chat-input');
  const text = input.value.trim();
  if (!text) return;
  input.value = '';
  addChatMsg('user', text);
  document.getElementById('chat-free-input').style.display = 'none';
  setTimeout(() => {
    const responses = [
      `「${text.slice(0,10)}${text.length>10?'…':''}」、聞かせてくれてありがとう。その気持ち、大切にしたいですね。`,
      'その言葉、忘れずにいます。次に話す時にまた教えてください。',
      'うん、そうか。あなたがそう感じているということを、私は知っておきたかった。',
    ];
    addChatMsg('companion', responses[Math.floor(Math.random() * responses.length)]);
  }, 900);
}

function addPostSessionChat() {
  const flow = CHAT_FLOW[companion.escape] || CHAT_FLOW.lonely;
  const idx = companion.chatFlowIdx || 0;
  if (idx < flow.length) {
    addChatMsg('companion', flow[idx].text);
    setTimeout(() => showChatReplies(idx), 400);
  } else {
    addChatMsg('companion', `${focusDuration}分間、一緒にいられましたね。今どんな気持ちですか？`);
    setTimeout(() => showFreeInput(), 400);
  }
}

// ── PERSIST ──
function save() {
  localStorage.setItem('tomo_user', JSON.stringify(userData));
  localStorage.setItem('tomo_companion', JSON.stringify(companion));
}

function load() {
  try {
    const u = localStorage.getItem('tomo_user');
    const c = localStorage.getItem('tomo_companion');
    if (u) userData = JSON.parse(u);
    if (c) companion = JSON.parse(c);
    return !!(u && c && companion.name);
  } catch(e) { return false; }
}

// ── TOAST ──
let toastTimer;
function showToast(msg) {
  const t = document.getElementById('toast');
  t.textContent = msg;
  t.classList.add('show');
  clearTimeout(toastTimer);
  toastTimer = setTimeout(() => t.classList.remove('show'), 2800);
}

// ── BOOT ──
if (load()) {
  document.getElementById('onboard').style.display = 'none';
  document.getElementById('app').style.display = 'block';
  initApp();
}
</script>
</body>
</html>
