        <path d="M7 17c0-2.21 1.79-4 4-4s4 1.79 4 4"/>
      </svg>
    </div>フォーカス
  </button>
  <button class="nav-item" onclick="switchPage('challenge',this)">
    <div class="nav-icon">
      <svg width="22" height="22" viewBox="0 0 22 22" fill="none" stroke="currentColor" stroke-width="1.5">
        <path d="M11 2L13.5 8.5H20L14.5 12.5L16.5 19L11 15L5.5 19L7.5 12.5L2 8.5H8.5L11 2Z"/></svg>
    </div>チャレンジ
  </button>
  <button class="nav-item" onclick="switchPage('profile',this)">
    <div class="nav-icon">
      <svg width="22" height="22" viewBox="0 0 22 22" fill="none" stroke="currentColor" stroke-width="1.5">
        <circle cx="11" cy="8" r="4"/>
        <path d="M3 19c0-4 3.6-7 8-7s8 3 8 7"/></svg>
    </div>マイページ
  </button>
</nav>

<!-- MODAL: ALTERNATIVE ACTIONS -->
<div class="modal-overlay" id="modal-alt">
  <div class="modal">
    <div class="modal-handle"></div>
    <div class="modal-title">今できる代替行動</div>
    <div class="modal-sub">スマホの代わりに試してみましょう。どれか一つでも十分です。</div>
    <div id="alt-actions">
      <div class="card" style="margin-bottom:10px;">
        <div style="font-size:22px;margin-bottom:8px;">🌬️</div>
        <div class="card-title">4-7-8呼吸法</div>
        <div class="card-sub">4秒吸って、7秒止めて、8秒で吐く。3回繰り返すと落ち着く。</div>
      </div>
      <div class="card" style="margin-bottom:10px;">
        <div style="font-size:22px;margin-bottom:8px;">🚶</div>
        <div class="card-title">5分間散歩</div>
        <div class="card-sub">外に出て空を見るだけで気分がリセットされる。</div>
      </div>
      <div class="card" style="margin-bottom:16px;">
        <div style="font-size:22px;margin-bottom:8px;">📝</div>
        <div class="card-title">3つの感謝を書く</div>
        <div class="card-sub">今日良かったことを3つメモするだけで幸福感が上がる。</div>
      </div>
    </div>
    <button class="btn-ghost" onclick="closeModal('modal-alt')">閉じる</button>
  </div>
</div>

<!-- MODAL: LOG TRIGGER -->
<div class="modal-overlay" id="modal-log">
  <div class="modal">
    <div class="modal-handle"></div>
    <div class="modal-title">今の気分を記録</div>
    <div class="modal-sub">何が今スマホを開かせましたか？記録するだけで意識が変わります。</div>
    <div class="trigger-grid" id="modal-trigger-grid">
      <button class="trigger-btn" onclick="selectModalTrigger(this,'退屈')"><div class="trigger-emoji">😑</div><div class="trigger-label">退屈</div></button>
      <button class="trigger-btn" onclick="selectModalTrigger(this,'不安')"><div class="trigger-emoji">😰</div><div class="trigger-label">不安</div></button>
      <button class="trigger-btn" onclick="selectModalTrigger(this,'習慣')"><div class="trigger-emoji">🔄</div><div class="trigger-label">習慣</div></button>
      <button class="trigger-btn" onclick="selectModalTrigger(this,'ストレス')"><div class="trigger-emoji">😤</div><div class="trigger-label">ストレス</div></button>
      <button class="trigger-btn" onclick="selectModalTrigger(this,'孤独')"><div class="trigger-emoji">🫠</div><div class="trigger-label">孤独</div></button>
      <button class="trigger-btn" onclick="selectModalTrigger(this,'先延ばし')"><div class="trigger-emoji">🙈</div><div class="trigger-label">先延ばし</div></button>
    </div>
    <div style="height:12px;"></div>
    <button class="btn" onclick="saveModalTrigger()">記録して閉じる</button>
    <button class="btn-ghost" onclick="closeModal('modal-log')">キャンセル</button>
  </div>
</div>

<!-- MODAL: ABANDON CONFIRM -->
<div class="modal-overlay" id="modal-abandon">
  <div class="modal">
    <div class="modal-handle"></div>
    <div class="modal-title">セッションを中断しますか？</div>
    <div class="modal-sub">アプリを離れると木が枯れてしまいます。本当に中断しますか？</div>
    <button class="btn" style="background:rgba(255,107,107,0.85);margin-bottom:8px;" onclick="doAbandon()">中断する 🥀</button>
    <button class="btn-ghost" onclick="closeModal('modal-abandon')">続ける 🌱</button>
  </div>
</div>

<script>
// ===== HOME PAGE =====
const days = ['月','火','水','木','金','土','今'];
const hours = [3.5, 2.8, 4.2, 3.1, 2.6, 3.8, 2.6];
const maxH = Math.max(...hours);

const chart = document.getElementById('weekly-chart');
days.forEach((d, i) => {
  const pct = Math.round((hours[i] / maxH) * 100);
  const isToday = i === 6;
  const isGood = hours[i] <= 3;
  const div = document.createElement('div');
  div.className = 'bar-wrap';
  div.innerHTML = `<div class="bar${isToday?' today':isGood?' good':''}" style="height:${pct}%"></div>`;
  chart.appendChild(div);
});

const streakRow = document.getElementById('streak-row');
['月','火','水','木','金','土','今'].forEach((d, i) => {
  const el = document.createElement('div');
  el.className = 'streak-day' + (i < 6 ? ' done' : ' today');
  el.textContent = d;
  streakRow.appendChild(el);
});

const cgrid = document.getElementById('challenge-grid');
for (let i = 1; i <= 21; i++) {
  const el = document.createElement('div');
  el.className = 'streak-day' + (i < 7 ? ' done' : i === 7 ? ' today' : '');
  el.style.cssText = 'width:100%;height:32px;border-radius:6px;';
  el.textContent = i;
  cgrid.appendChild(el);
}

const now = new Date();
const dateEl = document.getElementById('today-date');
const days2 = ['SUN','MON','TUE','WED','THU','FRI','SAT'];
dateEl.textContent = `${now.getFullYear()}.${String(now.getMonth()+1).padStart(2,'0')}.${String(now.getDate()).padStart(2,'0')} ${days2[now.getDay()]}`;

function switchPage(name, btn) {
  if (focusTimerInterval && name !== 'focus') {
    showToast('🌱 フォーカス中です。画面に戻るか中断してください');
    return;
  }
  document.querySelectorAll('.page').forEach(p => p.classList.remove('active'));
  document.querySelectorAll('.nav-item').forEach(b => b.classList.remove('active'));
  document.getElementById('page-' + name).classList.add('active');
  btn.classList.add('active');
  if (name === 'focus') renderForest();
}

let selectedTrigger = null;
let modalTrigger = null;

function selectTrigger(el, name) {
  document.querySelectorAll('#trigger-grid .trigger-btn').forEach(b => b.classList.remove('selected'));
  el.classList.add('selected');
  selectedTrigger = name;
}

function selectModalTrigger(el, name) {
  document.querySelectorAll('#modal-trigger-grid .trigger-btn').forEach(b => b.classList.remove('selected'));
  el.classList.add('selected');
  modalTrigger = name;
}

function saveTriggerLog() {
  if (!selectedTrigger) { showToast('トリガーを選んでください'); return; }
  const list = document.getElementById('log-list');
  const t = new Date();
  const time = `${String(t.getHours()).padStart(2,'0')}:${String(t.getMinutes()).padStart(2,'0')}`;
  const colors = {退屈:'var(--text3)',不安:'var(--accent)',習慣:'var(--amber)',通知:'var(--green)',暇つぶし:'var(--text3)',孤独:'var(--pink)',ストレス:'var(--red)',先延ばし:'var(--amber)',その他:'var(--text3)'};
  const item = document.createElement('div');
  item.className = 'log-item';
  item.innerHTML = `<div class="log-dot" style="background:${colors[selectedTrigger]||'var(--text3)'}"></div><div class="log-time">${time}</div><div class="log-text">今記録</div><div class="log-trigger">${selectedTrigger}</div>`;
  list.insertBefore(item, list.firstChild);
  document.querySelectorAll('#trigger-grid .trigger-btn').forEach(b => b.classList.remove('selected'));
  selectedTrigger = null;
  showToast('✓ 記録しました！');
}

function saveModalTrigger() {
  if (!modalTrigger) { showToast('トリガーを選んでください'); return; }
  closeModal('modal-log');
  showToast(`✓ 「${modalTrigger}」を記録しました`);
}

function showAlternative() { document.getElementById('modal-alt').classList.add('open'); }
function logTrigger() { document.getElementById('modal-log').classList.add('open'); }
function closeModal(id) { document.getElementById(id).classList.remove('open'); }

document.querySelectorAll('.modal-overlay').forEach(m => {
  m.addEventListener('click', e => { if (e.target === m) m.classList.remove('open'); });
});

function toggleMission(el) {
  const check = el.querySelector('.mission-check');
  const title = el.querySelector('.mission-title');
  const isDone = check.classList.contains('done');
  if (isDone) {
    check.classList.remove('done');
    check.innerHTML = '';
    title.classList.remove('done');
  } else {
    check.classList.add('done');
    check.innerHTML = `<svg width="12" height="10" viewBox="0 0 12 10" fill="none"><path d="M1 5L4.5 8.5L11 1" stroke="#0c0c10" stroke-width="2" stroke-linecap="round"/></svg>`;
    title.classList.add('done');
    showToast('ミッション達成！🎉');
  }
}

let toastTimer;
function showToast(msg) {
  const t = document.getElementById('toast');
  t.textContent = msg;
  t.classList.add('show');
  clearTimeout(toastTimer);
  toastTimer = setTimeout(() => t.classList.remove('show'), 2800);
}

const suggestions = [
  '今日は「退屈」でスマホを開く回数が多いですね。代わりに深呼吸を3回してみましょう。',
  'スクリーンタイムが昨日より15分少ないです。この調子を続けましょう！',
  '夜21時以降のスマホ使用が睡眠を妨げています。今夜は早めに置きましょう。',
  '「先延ばし」のトリガーが多いです。今すぐ5分だけ作業を始めてみて。',
];
document.getElementById('ai-suggestion').textContent = suggestions[Math.floor(Math.random() * suggestions.length)];


// ===== FOCUS SESSION (Forest-style) =====
let focusDuration = 25;
let focusPlantType = 'tree';
let focusPlantEmoji = '🌳';
let focusTimerInterval = null;
let focusSecondsLeft = 0;
let focusTotalSeconds = 0;
let leaveTimestamp = null;
let leaveGraceTimer = null;

const LEAVE_KILL_THRESHOLD = 10000; // 10 seconds away = tree dies

const plantStages = {
  tree:   ['🌱','🌱','🌿','🌿','🌳'],
  flower: ['🌱','🌱','🌼','🌼','🌸'],
  bamboo: ['🌱','🌱','🎍','🎍','🎋'],
  pine:   ['🌱','🌱','🌿','🌿','🌲'],
};

const focusTips = [
  'スマホから離れて、今この瞬間だけに集中しましょう。',
  '集中が深まるほど、木は大きく育ちます。',
  '一つのことに集中する時間が、最高の生産性を生みます。',
  '木が育つのを楽しみに、スマホを置いてみましょう。',
  '集中した時間は、あなたの財産になります。',
];

function selectPlant(el, type, emoji) {
  document.querySelectorAll('.plant-opt').forEach(p => p.classList.remove('selected'));
  el.classList.add('selected');
  focusPlantType = type;
  focusPlantEmoji = emoji;
}

function selectDuration(el, mins) {
  document.querySelectorAll('.dur-btn').forEach(d => d.classList.remove('selected'));
  el.classList.add('selected');
  focusDuration = mins;
}

function showFocusState(state) {
  document.querySelectorAll('.focus-state').forEach(s => s.classList.remove('active'));
  document.getElementById('fs-' + state).classList.add('active');
}

function beginFocusSession() {
  focusSecondsLeft = focusDuration * 60;
  focusTotalSeconds = focusSecondsLeft;
  leaveTimestamp = null;

  const plantEl = document.getElementById('focus-plant-emoji');
  plantEl.textContent = '🌱';
  plantEl.className = 'plant-emoji-large';
  plantEl.style.transform = 'scale(0.5)';

  document.getElementById('focus-progress-ring').style.strokeDashoffset = '553';
  document.getElementById('focus-timer').className = 'session-timer';
  document.getElementById('focus-label').textContent = '木が育っています...';
  document.getElementById('leave-banner').classList.remove('show');
  document.getElementById('focus-tip').textContent = focusTips[Math.floor(Math.random() * focusTips.length)];

  showFocusState('running');
  updateFocusDisplay();

  focusTimerInterval = setInterval(focusTick, 1000);

  document.addEventListener('visibilitychange', onFocusVisibilityChange);
  window.addEventListener('pagehide', onFocusPageHide);
}

function focusTick() {
  focusSecondsLeft = Math.max(0, focusSecondsLeft - 1);
  if (focusSecondsLeft === 0) {
    completeFocusSession();
  } else {
    updateFocusDisplay();
  }
}

function updateFocusDisplay() {
  const mins = Math.floor(focusSecondsLeft / 60);
  const secs = focusSecondsLeft % 60;
  document.getElementById('focus-timer').textContent =
    String(mins).padStart(2, '0') + ':' + String(secs).padStart(2, '0');

  const progress = 1 - (focusSecondsLeft / focusTotalSeconds);
  document.getElementById('focus-progress-ring').style.strokeDashoffset =
    String(553 * (1 - progress));

  const stages = plantStages[focusPlantType] || plantStages.tree;
  const stageIndex = Math.min(4, Math.floor(progress * 5));
  const plantEl = document.getElementById('focus-plant-emoji');
  plantEl.textContent = stages[stageIndex];

  const scale = 0.5 + progress * 0.5;
  plantEl.style.transform = `scale(${scale})`;
}

function onFocusVisibilityChange() {
  if (!focusTimerInterval) return;

  if (document.hidden) {
    leaveTimestamp = Date.now();
  } else {
    if (leaveTimestamp !== null) {
      const away = Date.now() - leaveTimestamp;
      leaveTimestamp = null;
      if (away > LEAVE_KILL_THRESHOLD) {
        killFocusSession();
      } else {
        const banner = document.getElementById('leave-banner');
        banner.textContent = `⚠️ ${Math.round(away / 1000)}秒離れていました。木はまだ生きています！`;
        banner.classList.add('show');
        setTimeout(() => banner.classList.remove('show'), 3500);
      }
    }
  }
}

function onFocusPageHide() {
  leaveTimestamp = Date.now();
}

function killFocusSession() {
  if (!focusTimerInterval) return;
  clearInterval(focusTimerInterval);
  focusTimerInterval = null;
  removeFocusListeners();
  updateNavFocusState(false);

  const elapsed = focusTotalSeconds - focusSecondsLeft;
  const progressPct = Math.round((elapsed / focusTotalSeconds) * 100);
  const elapsedMins = Math.floor(elapsed / 60);

  const stages = plantStages[focusPlantType] || plantStages.tree;
  const stageIndex = Math.min(4, Math.floor((elapsed / focusTotalSeconds) * 5));
  document.getElementById('dead-plant-emoji').textContent = progressPct < 5 ? '🥀' : stages[stageIndex];

  document.getElementById('dead-msg').textContent =
    progressPct >= 80 ? 'あと少しでした！次はきっと完走できます。' :
    progressPct >= 50 ? `半分以上（${elapsedMins}分）集中できました。素晴らしい！` :
    elapsedMins >= 1 ? `${elapsedMins}分まで集中できました。次はもっといける！` :
    '次は最後まで集中できますよ。諦めないで！';

  document.getElementById('dead-progress-msg').textContent =
    progressPct > 0 ? `達成率 ${progressPct}%` : '';

  showFocusState('dead');
}

function completeFocusSession() {
  clearInterval(focusTimerInterval);
  focusTimerInterval = null;
  removeFocusListeners();
  updateNavFocusState(false);

  const stages = plantStages[focusPlantType] || plantStages.tree;
  const finalEmoji = stages[4];

  document.getElementById('complete-plant-emoji').textContent = finalEmoji;
  document.getElementById('complete-label').textContent = `${focusDuration}分間 集中しました`;

  const forest = JSON.parse(localStorage.getItem('mindful_forest') || '[]');
  forest.push({
    plant: focusPlantType,
    emoji: finalEmoji,
    duration: focusDuration,
    date: new Date().toISOString(),
  });
  localStorage.setItem('mindful_forest', JSON.stringify(forest));

  showFocusState('complete');
  showToast('🌳 木が森に植えられました！');
}

function confirmAbandon() {
  document.getElementById('modal-abandon').classList.add('open');
}

function doAbandon() {
  closeModal('modal-abandon');
  killFocusSession();
}

function restartFocus() {
  showFocusState('setup');
  renderForest();
}

function exitFocusSession() {
  if (focusTimerInterval) {
    clearInterval(focusTimerInterval);
    focusTimerInterval = null;
    removeFocusListeners();
    updateNavFocusState(false);
  }
  showFocusState('setup');
  renderForest();
}

function removeFocusListeners() {
  document.removeEventListener('visibilitychange', onFocusVisibilityChange);
  window.removeEventListener('pagehide', onFocusPageHide);
  clearTimeout(leaveGraceTimer);
}

function updateNavFocusState(active) {
  const navFocus = document.getElementById('nav-focus');
  if (active) navFocus.classList.add('session-live');
  else navFocus.classList.remove('session-live');
}

function renderForest() {
  const forest = JSON.parse(localStorage.getItem('mindful_forest') || '[]');
  const grid = document.getElementById('forest-grid');
  const empty = document.getElementById('forest-empty');
  const statsRow = document.getElementById('forest-stats-row');

  grid.innerHTML = '';

  if (forest.length === 0) {
    empty.style.display = 'block';
    statsRow.style.display = 'none';
    return;
  }

  empty.style.display = 'none';
  statsRow.style.display = 'flex';

  const totalMins = forest.reduce((s, t) => s + t.duration, 0);
  const totalHours = totalMins >= 60
    ? (totalMins / 60).toFixed(1) + 'h'
    : totalMins + 'm';

  statsRow.innerHTML = `
    <div class="forest-stat">
      <div class="forest-stat-val" style="color:var(--green)">${forest.length}</div>
      <div class="forest-stat-key">木の本数</div>
    </div>
    <div class="forest-stat">
      <div class="forest-stat-val" style="color:var(--accent)">${totalHours}</div>
      <div class="forest-stat-key">合計集中</div>
    </div>
    <div class="forest-stat">
      <div class="forest-stat-val" style="color:var(--amber)">${forest.filter(t => {
        const d = new Date(t.date);
        const today = new Date();
        return d.toDateString() === today.toDateString();
      }).length}</div>
      <div class="forest-stat-key">今日の木</div>
    </div>
  `;

  const recent = [...forest].reverse().slice(0, 20);
  recent.forEach(t => {
    const el = document.createElement('div');
    el.className = 'forest-tree';
    const d = new Date(t.date);
    const label = `${d.getMonth() + 1}/${d.getDate()}`;
    el.innerHTML = `
      <div class="forest-tree-emoji">${t.emoji}</div>
      <div class="forest-tree-time">${label}</div>
      <div class="forest-tree-dur">${t.duration}分</div>
    `;
    grid.appendChild(el);
  });
}
</script>
</body>
</html>
